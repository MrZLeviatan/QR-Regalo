# /**
#  * Configuración de QR Regalo. Copia este archivo como .env y completa los
#  * valores. El .env no se sube a git (contiene el token).
#  **/

# Publicación web (GitHub Pages): el QR funciona con datos móviles o cualquier Wi-Fi.
# Token fine-grained creado en https://github.com/settings/personal-access-tokens
# con acceso SOLO al repositorio de abajo y permisos "Contents" y "Pages" en
# lectura y escritura.
GITHUB_TOKEN=
# Repositorio PÚBLICO (puede estar vacío) donde se guardan los PDF: usuario/nombre.
GITHUB_REPO=MrZLeviatan/carta-el-regalo

# Traducción automática (botón "Traducir lo que falta"). Sin configurar nada se
# usa MyMemory, gratis y sin registro (~5.000 caracteres/día); con un correo
# el límite sube a ~50.000 caracteres/día.
MYMEMORY_EMAIL=
# Alternativas (las mismas del catálogo El Regalo; si se definen, tienen prioridad):
# servidor LibreTranslate propio (docker run -p 5000:5000 libretranslate/libretranslate)
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# DeepL API Free (claves terminadas en ":fx", 500.000 caracteres/mes).
DEEPL_API_KEY=

# Opcionales.
PORT=8090
DATA_DIR=data
# Solo sin GitHub: dirección que va en el QR (por defecto la IP de la red local).
BASE_URL=
